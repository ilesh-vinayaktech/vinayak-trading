# Copy to .env (never commit .env). Development defaults; see docs/portal/DESIGN.md.
ALGO_DB_URL=postgresql://postgres:dev@localhost:5433/algo
# Which prices the readers use: kite (primary) or bhavcopy (backup).
ALGO_PRICE_SOURCE=kite
# Zerodha Kite Connect credentials of the SYSTEM data feed (per-user credentials are stored encrypted in the portal).
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
# Portal: key ring for encrypted secrets. Generate: python3 -c "import os,base64;print('v1:'+base64.b64encode(os.urandom(32)).decode())"
ALGO_VAULT_KEYS=
ALGO_VAULT_CURRENT=v1
# Plain-HTTP local development only. Production keeps secure cookies (leave unset).
ALGO_COOKIE_SECURE=0
ALGO_CORS_ORIGINS=http://localhost:3000
# Set to 1 only behind a reverse proxy that appends the real client address to X-Forwarded-For.
ALGO_TRUST_PROXY=0
